# GreenPT API Configuration
# Get your API key from your hackathon organizer
GREENPT_API_KEY=your_greenpt_api_key_here
GREENPT_MODEL=gpt-4-1106-preview
GREENPT_MAX_TOKENS=1500
GREENPT_TEMPERATURE=0.7

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security (for production)
SECRET_KEY=generate_a_random_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (for future expansion)
# DATABASE_URL=postgresql://user:password@localhost/gemeente_ai

# ============================================
# N8N VALIDATION LAYER (SECURITY)
# ============================================
# Enable/disable n8n validation of AI responses before showing to users
# Set to "true" to enable the security validation layer
N8N_VALIDATION_ENABLED=true

# Your n8n webhook URL (get this from your n8n workflow)
# This is the webhook trigger URL from your n8n validation workflow
N8N_WEBHOOK_URL=https://qualogy.app.n8n.cloud/webhook-test/4ce552fb-b0f1-4f80-b114-ecc6fd7f659a


# Timeout for validation requests (seconds)
# How long to wait for n8n to validate before falling back
N8N_VALIDATION_TIMEOUT=30
